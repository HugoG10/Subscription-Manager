{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "subscription-manager": {
      "root": ".",
      "entrypoint": "main:app",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "subscription-manager"
      }
    }
  ]
}
